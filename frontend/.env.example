# ─────────────────────────────────────────────────────────────
# EMC Helpline — frontend environment
# Copy to `.env.local` (git-ignored) and adjust as needed.
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put API keys or secrets in this file: it ships to clients.
# ─────────────────────────────────────────────────────────────

# Base URL of the FastAPI backend.
# Leave EMPTY to call same-origin "/api/..." — in dev this is forwarded by the
# Vite proxy, in production by your reverse proxy / static server.
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards "/api" during `npm run dev`.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Request timeout in milliseconds for chat calls (RAG + Gemini can be slow).
VITE_API_TIMEOUT_MS=45000
